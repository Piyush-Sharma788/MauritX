{
  "name": "marutix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "MONGODB_URI_TEST=mongodb://127.0.0.1:27017/marutix_test vitest run",
    "whatsapp:worker": "tsx --conditions=react-server --env-file=.env.local src/worker/whatsapp/main.ts",
    "whatsapp:worker:prod": "NODE_ENV=production tsx --conditions=react-server src/worker/whatsapp/main.ts",
    "admin:grant": "tsx --conditions=react-server --env-file=.env.local scripts/admin-role.ts grant",
    "admin:revoke": "tsx --conditions=react-server --env-file=.env.local scripts/admin-role.ts revoke"
  },
  "dependencies": {
    "mongoose": "^9.11.4",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
