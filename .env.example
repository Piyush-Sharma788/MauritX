# MarutiX environment. Copy to .env.local for development. Placeholders only:
# never commit real values. Use a secret manager in production and never put
# server secrets in NEXT_PUBLIC_* variables.

# --- Core ---------------------------------------------------------------
# MongoDB connection string (Atlas in staging/production).
MONGODB_URI=mongodb://127.0.0.1:27017/marutix
# Public origin of the app. Used for CSRF origin checks; must match the URL
# you open in the browser exactly (http://localhost:3000, not 127.0.0.1).
APP_BASE_URL=http://localhost:3000

# --- Secrets (generate each with: openssl rand -base64 32) ---------------
# Keys the hashes of opaque, server-side session tokens. Sessions are
# revocable database records; no JWTs are issued. Rotating signs everyone out.
AUTH_JWT_SECRET=
# Keys OTP hashes and rate-limit identifiers.
OTP_HASH_SECRET=
# 32-byte base64 key for AES-256-GCM encryption of phone numbers and the
# phone lookup token. Rotating it requires a data migration.
PII_ENCRYPTION_KEY=

# --- OTP delivery ---------------------------------------------------------
# "whatsapp" or "development". If unset: whatsapp when the WhatsApp variables
# below are set, otherwise development (never allowed in production).
# The development provider sends NOTHING; it prints the code to the server
# terminal and the UI labels it as development-only.
OTP_PROVIDER=

# --- WhatsApp Business Platform Cloud API ---------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved AUTHENTICATION template with a copy-code button.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- WhatsApp messaging provider ------------------------------------------
# whatsapp_web (default): the whatsapp-web.js pilot drains the outbox.
# whatsapp_cloud: the official Cloud API (same WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID as above); the jobs worker drains the outbox and
# inbound messages arrive at POST /api/v1/webhooks/whatsapp.
MESSAGING_PROVIDER=whatsapp_web
# Meta App Dashboard → App settings → Basic → App secret. Verifies webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string (openssl rand -hex 16); enter the same value in the webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Approved UTILITY templates for messages outside the 24-hour reply window
# (exact wording in WHATSAPP_BOT.md §12). Without them, alerts can only reach
# people who messaged MarutiX in the last 24 hours.
WHATSAPP_TEMPLATE_EMERGENCY_ALERT=
WHATSAPP_TEMPLATE_REQUEST_CONFIRMATION=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_CLOUD_MAX_MESSAGES_PER_HOUR=250
WHATSAPP_CLOUD_MAX_REPLIES_PER_HOUR=1000
WHATSAPP_CLOUD_MIN_SEND_INTERVAL_MS=250

# --- Security ---------------------------------------------------------------
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (1 for Vercel, Caddy or Nginx). The client IP used for rate limits is taken
# from the right, so clients can't spoof it. 0 = no proxy (IP rate limits share one bucket).
TRUSTED_PROXY_HOPS=1
# Session limits. Admin sessions see decrypted patient and donor data.
SESSION_IDLE_HOURS=72
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_SESSION_MAX_HOURS=12

# --- Privacy and monitoring --------------------------------------------------
# Closed emergency requests lose patient and requester details after this many days (7-3650).
REQUEST_RETENTION_DAYS=180
# Optional https webhook (Slack-compatible {"text": ...}) for unexpected server errors.
# At most one alert per kind of error every 30 minutes; messages are redacted.
ERROR_ALERT_WEBHOOK_URL=

# --- SMS fallback for sign-in codes (optional) -------------------------------
# "none" (default) or "twilio". India: register the sender ID and the exact message
# text as a DLT template first (through Twilio), or operators drop the SMS.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Recommended: a Messaging Service with your DLT-registered sender. Otherwise TWILIO_FROM.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Must match the DLT template exactly; {code} and {minutes} are filled in.
SMS_OTP_BODY_TEMPLATE=
# Cost / abuse caps: SMS codes per number per day, and for the whole service per day.
OTP_SMS_PER_PHONE_DAILY=3
OTP_SMS_DAILY_CAP=500

# --- Development only ---------------------------------------------------------
# Extra hostnames allowed to load dev resources (HMR) besides localhost and this
# machine's own LAN IPs, e.g. a tunnel: my-app.ngrok.app. Comma-separated, no scheme/port.
DEV_ALLOWED_ORIGINS=

# --- Reserved for later phases ---------------------------------------------
MAPS_API_KEY=
REDIS_URL=

# --- WhatsApp Web pilot (whatsapp-web.js; unofficial, controlled pilot) ---
# Runs in a separate worker process: npm run whatsapp:worker
# Loopback URL the admin API uses to reach the worker's control channel.
WHATSAPP_WEB_WORKER_URL=http://127.0.0.1:3100
# Shared secret between the web app and the worker (openssl rand -base64 32).
WHATSAPP_WEB_WORKER_SECRET=
# LocalAuth session directory. Grants full access to the linked account:
# keep it outside public/ and src/, on an encrypted disk, mode 0700.
WHATSAPP_WEB_SESSION_DIR=.data/whatsapp-session
WHATSAPP_WEB_DEVICE_NAME=MarutiX Pilot
# Public number of the paired pilot WhatsApp account (e.g. +919XXXXXXXXX).
# "Become a Donor" opens a chat with it (wa.me) with REGISTER pre-filled.
# Static pages pick up a change on the next build.
WHATSAPP_WEB_PUBLIC_NUMBER=
# Comma-separated Indian numbers admins may send test messages to.
WHATSAPP_WEB_TEST_RECIPIENTS=
WHATSAPP_WEB_MAX_MESSAGES_PER_HOUR=30
# Separate cap for bot replies in conversations the person started.
WHATSAPP_WEB_MAX_REPLIES_PER_HOUR=300
WHATSAPP_WEB_MIN_SEND_INTERVAL_MS=4000
# Queued messages older than this are never sent.
WHATSAPP_WEB_MESSAGE_TTL_MINUTES=15
# Set true only in Linux containers that must run Chromium without a sandbox.
WHATSAPP_WEB_NO_SANDBOX=false
# Optional: use a specific Chrome/Chromium instead of Puppeteer's download.
# PUPPETEER_EXECUTABLE_PATH=

# --- Emergency alerts and donor matching (Phase 5) --------------------------
# Alerts are never automatic: an admin searches for donors and sends small
# batches. Every value below has a conservative default.
ALERT_BATCH_SIZE=5
ALERT_MAX_PER_REQUEST=40
ALERT_MAX_PER_DONOR_PER_DAY=2
# Alerts not sent within this window are dropped (stale requests do harm).
ALERT_TTL_MINUTES=60
# Donors whose self-reported last donation is more recent than this are not
# contacted. A coordination aid only; the blood centre decides eligibility.
MATCH_MIN_DONATION_INTERVAL_DAYS=90
MATCH_MAX_CANDIDATES=100

# --- AI understanding for the WhatsApp bot (optional) ----------------------
# "none" (default): commands and keyword matching only.
# "anthropic": Claude classifies free text and extracts details. It only
# proposes; the bot validates everything and asks before any change.
# Phone numbers are removed from messages before they are sent to the provider.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=10000
AI_MAX_CALLS_PER_NUMBER_PER_HOUR=20

# --- Automated coordination (Phase 6) ---------------------------------------
# Runs in the jobs worker: npm run jobs:worker. Starts only after an admin
# verifies AND activates a request.
COORDINATION_AUTOSTART=true
# Donor notification zones (operational distances, not medical rules).
DONOR_ZONES_KM=5,10,25,50
DONOR_WAVE_SIZE=5
DONOR_WAVE_INTERVAL_MINUTES=20
# Stop widening once this many donors are interested; 0 = twice the units.
DONOR_TARGET_INTERESTED=0
# Institutional outreach.
OUTREACH_RADIUS_KM=25
OUTREACH_MAX_INSTITUTIONS=10
# false (recommended): discovered email addresses are used only after an admin
# approves the institution. true: email unreviewed discovered addresses too.
OUTREACH_INCLUDE_UNREVIEWED=false
OUTREACH_MAX_PER_INSTITUTION_PER_DAY=5
# Shown in outreach messages as the responsible MarutiX coordinator (optional).
COORDINATOR_CONTACT_PHONE=
COORDINATOR_CONTACT_EMAIL=

# --- Institution discovery ----------------------------------------------------
# "none": only institutions already in MarutiX. "openstreetmap": also query
# OpenStreetMap (Overpass + Nominatim). Their usage policies require an
# identifying contact and light use; consider your own Overpass instance.
DISCOVERY_PROVIDER=none
DISCOVERY_CONTACT_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Read official mailto:/tel: links from institutions' own websites (robots.txt honoured).
DISCOVERY_WEBSITE_ENRICHMENT=true
DISCOVERY_TIMEOUT_MS=60000

# --- Outreach email -------------------------------------------------------------
# "none": no email is sent and outreach shows "Email not configured".
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_MAX_PER_HOUR=60
