# /etc/marutix/backup.env  (chmod 600, owner marutix-backup)
# A read-only database user is enough for backups (role: backup).
MONGODB_URI=mongodb+srv://marutix-backup:...@cluster.example.mongodb.net/marutix
BACKUP_DIR=/var/backups/marutix
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/marutix/backup.passphrase
# Point-in-time dump on replica sets / Atlas.
BACKUP_OPLOG=1
# Restore drill: a scratch database the drill may drop. Use a user with readWrite on that database only.
RESTORE_TEST_URI=mongodb://127.0.0.1:27017/marutix_restore_test
# The app's production env file, for PII_ENCRYPTION_KEY and friends.
ENV_FILE=/opt/marutix/.env.production
# Docker hosts: verify inside the deployed worker image instead of a Node checkout.
# VERIFY_IMAGE=ghcr.io/<owner>/marutix-worker:<tag>
