# syntax=docker/dockerfile:1.7
# MarutiX WhatsApp Web pilot worker (whatsapp-web.js + system Chromium).

ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app

# System Chromium instead of Puppeteer's download, plus fonts for Indic scripts and emoji.
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-noto-core fonts-noto-color-emoji ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY package.json package-lock.json ./
# Full install: the worker runs TypeScript through tsx.
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
# Operator scripts (admin roles, MFA reset, restore verification) run in this image too.
COPY scripts ./scripts

# Session files live on a mounted volume, owned by the unprivileged user.
RUN mkdir -p /app/.data && chown -R node:node /app/.data
USER node
ENV NODE_ENV=production \
    WHATSAPP_WEB_SESSION_DIR=/app/.data/whatsapp-session

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3100/health',{headers:{Authorization:'Bearer '+process.env.WHATSAPP_WEB_WORKER_SECRET}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node_modules/.bin/tsx", "--conditions=react-server", "src/worker/whatsapp/main.ts"]
